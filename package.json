{
  "name": "miniharness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A minimal coding-agent harness for agent CLI invocation only - one headless summon, one JSON envelope out.",
  "bin": {
    "miniharness": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
