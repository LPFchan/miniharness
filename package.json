{
  "name": "miniharness",
  "version": "0.1.10",
  "type": "module",
  "description": "A minimal coding-agent harness for agent CLI invocation only - one headless summon, one JSON envelope out.",
  "license": "UNLICENSED",
  "bin": {
    "miniharness": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
